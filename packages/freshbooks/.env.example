# Copy this to .env and fill in values from your FreshBooks developer app
# Create one at: https://my.freshbooks.com/#/developer

FRESHBOOKS_CLIENT_ID=your_client_id_here
FRESHBOOKS_CLIENT_SECRET=your_client_secret_here

# Optional: override default redirect URI (must match what you registered in your FreshBooks app)
# FRESHBOOKS_REDIRECT_URI=https://localhost:8765/callback

# Optional: override token storage location
# FRESHBOOKS_TOKENS_PATH=~/.freshbooks-mcp/tokens.json

# Optional: target a specific account/business. If unset, the values discovered
# during `npm run setup` (stored in tokens.json) are used. Set these only if your
# FreshBooks login owns multiple businesses and you want one other than the first.
# FRESHBOOKS_ACCOUNT_ID=your_account_id
# FRESHBOOKS_BUSINESS_ID=123456
