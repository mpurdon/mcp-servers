{
  "name": "@mpurdon/mcp-freshbooks",
  "version": "0.1.0",
  "description": "Local stdio MCP server for FreshBooks invoices, clients, items, and time entries.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "freshbooks": "dist/index.js",
    "freshbooks-setup": "dist/setup.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "freshbooks",
    "invoicing",
    "claude"
  ],
  "license": "MIT",
  "author": "Matthew Purdon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpurdon/mcp-servers.git",
    "directory": "packages/freshbooks"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "setup": "node dist/setup.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "exceljs": "^4.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mpurdon/eslint-config": "workspace:*",
    "@mpurdon/tsconfig": "workspace:*",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
